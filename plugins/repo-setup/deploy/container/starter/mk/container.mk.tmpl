# Container (repo-setup deploy layer): build and run the production image locally.
.PHONY: image up down
IMAGE ?= {{slug}}
TAG ?= local

# The code generated from ontology/ is drawn before the build and reaches the build context: the
# Dockerfile has no make or python3, and .dockerignore leaves src/ in.
image up: | derived

image: ## Build the production image
	docker build -t $(IMAGE):$(TAG) .

up: ## Run the production image locally (compose.yaml)
	docker compose up --build -d

down: ## Stop the local containers
	docker compose down
