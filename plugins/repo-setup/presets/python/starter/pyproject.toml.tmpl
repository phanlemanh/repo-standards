[project]
name = "{{slug}}"
version = "0.1.0"
description = "{{description}}"
readme = "README.md"
license = "{{license_spdx}}"
requires-python = ">=3.12"
dependencies = []

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{package_name}}"]

[tool.ruff]
line-length = 100
target-version = "py312"
src = ["src", "tests"]
# Generated from ontology/ (make gen): type-checked by mypy, not formatted or linted.
extend-exclude = ["src/*/ontology_types.py"]

[tool.ruff.lint]
select = [
  "E", "W", "F",  # pycodestyle, pyflakes
  "I",            # import sorting
  "B",            # bugbear
  "UP",           # pyupgrade
  "SIM",          # simplify
  "N",            # naming
  "S",            # bandit (security)
  "RUF",          # ruff-specific
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]  # assert is fine in tests

[tool.mypy]
strict = true
python_version = "3.12"
files = ["src", "tests"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra --strict-markers"
