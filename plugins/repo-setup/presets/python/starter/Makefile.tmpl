# One-command tasks. CI runs `make check`; run it before every PR.
.DEFAULT_GOAL := help
PKG := {{package_name}}
DEV_CMD := {{dev_cmd}}
GEN_OUT := src/$(PKG)/ontology_types.py
GEN_LANG := python
PYTEST_ARGS :=
PYTHON ?= uv run python
CHECK_TARGETS := lint typecheck test ontology

# Extra targets from repo-setup layers (architecture, governance, coverage...) live in mk/*.mk.
# They append to CHECK_TARGETS / PYTEST_ARGS, so `make check` grows with the setup.
-include mk/*.mk

# Every check step, those layers added in mk/*.mk too, waits for `make derived` (mk/derived.mk).
# `upgrade` runs first and `derived` waits for it, so it stays out of the list.
$(filter-out upgrade derived-untracked derived,$(CHECK_TARGETS)) dev: | derived

.PHONY: help setup dev format lint typecheck test gen ontology check clean

help: ## Show available commands
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  make %-10s %s\n", $$1, $$2}'

setup: ## Install dependencies from the lockfile
	uv sync --locked

dev: ## Run locally
	uv run $(DEV_CMD)

format: ## Auto-format and fix lint issues
	uv run ruff format .
	uv run ruff check --fix .

lint: ## Lint and check formatting
	uv run ruff check .
	uv run ruff format --check .

typecheck: ## Strict type check
	uv run mypy

test: ## Run tests
	uv run pytest $(PYTEST_ARGS)

# The generated file is committed (one-file) or drawn and kept out of git (fragments): see mk/derived.mk.
gen: ## Regenerate types from ontology/
	@if [ "$$($(LEDGERS_PYTHON) tools/ledgers.py shape gen --gen-out $(GEN_OUT))" = fragments ]; then $(MAKE) --no-print-directory gen-derived; else $(LEDGERS_PYTHON) tools/ontology_codegen.py --lang python --out $(GEN_OUT); fi

ontology: ## Check ontology/ + wiki/ consistency and generated code
	$(PYTHON) tools/wiki_lint.py
	@if [ "$$($(LEDGERS_PYTHON) tools/ledgers.py shape gen --gen-out $(GEN_OUT))" = one-file ]; then $(LEDGERS_PYTHON) tools/ontology_codegen.py --lang python --out $(GEN_OUT) --check; fi

check: $(CHECK_TARGETS) ## Everything CI runs

clean: ## Remove caches and build output
	rm -rf .mypy_cache .ruff_cache .pytest_cache dist build
