"""Run the evals against the real API. This costs money, so it is not part of `make check`."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

from {{package_name}}.feedback import classify_feedback
from {{package_name}}.llm import USAGE, make_client, model_name


def main() -> int:
    if not os.environ.get("ANTHROPIC_API_KEY"):
        print("evals call the real API: set ANTHROPIC_API_KEY first.", file=sys.stderr)
        return 2
    tasks = json.loads((Path(__file__).parent / "tasks.json").read_text(encoding="utf-8"))
    print(f"Running {len(tasks)} tasks on {model_name()}. This uses your API credit.")
    client = make_client()
    passed = 0
    for task in tasks:
        got = classify_feedback(task["input"], client).label
        ok = got == task["expect"]
        passed += ok
        print(f"{'ok  ' if ok else 'FAIL'} {task['id']}: got {got}")
    print(f"Passed {passed}/{len(tasks)}. Tokens: {dict(USAGE)}")
    return 0 if passed == len(tasks) else 1


if __name__ == "__main__":
    sys.exit(main())
